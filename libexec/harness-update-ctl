#!/usr/bin/env python3
"""Aggiorna gli harness e svolge un audit effimero quando cambia qualcosa.

Il job gira come root perché Codex e OpenCode sono installati globalmente;
Claude Code è invece aggiornato separatamente nelle home PROJECT e SERVER.
L'audit gira come PROJECT tramite ``codex exec --ephemeral``: non crea una TUI,
non compare fra le sessioni Agent Hub, usa un sandbox read-only e termina col
processo stesso. Il report JSON e' l'unico stato persistente del ciclo.
"""
import argparse
import fcntl
import json
import os
import pwd
import signal
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


CONFIG_FILE = "/etc/agent-hub/config.env"
SESSION_CTL = "/usr/local/libexec/agent-hub/session-ctl"
DEFAULT_STATE = "/var/lib/agent-hub/harness-update.json"
DEFAULT_AUDIT_TIMEOUT = 1200


def load_config(path=CONFIG_FILE):
    data = {}
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except OSError:
        return data
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip("\"'")
    return data


def user_env(user):
    account = pwd.getpwnam(user)
    runtime = f"/run/user/{account.pw_uid}"
    return {
        "HOME": account.pw_dir, "USER": user, "LOGNAME": user,
        "SHELL": "/bin/bash", "LANG": "C.UTF-8",
        "PATH": f"{account.pw_dir}/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "XDG_RUNTIME_DIR": runtime,
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime}/bus",
    }


def run(command, *, env=None, timeout=900):
    try:
        process = subprocess.Popen(
            command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, cwd=(env or {}).get("HOME") or "/", start_new_session=True)
    except OSError as exc:
        return {"ok": False, "rc": -1, "output": str(exc)[-6000:],
                "stdout": "", "stderr": str(exc)[-6000:]}
    timed_out = False
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = process.communicate()
    stdout = (stdout or "").strip()
    stderr = (stderr or "").strip()
    if timed_out:
        timeout_note = f"timeout dopo {timeout}s; intero process group terminato"
        stderr = (stderr + "\n" + timeout_note).strip()
    output = (stdout + ("\n" if stdout and stderr else "") + stderr).strip()
    return {"ok": process.returncode == 0 and not timed_out,
            "rc": -1 if timed_out else process.returncode,
            "output": output[-6000:], "stdout": stdout[-6000:],
            "stderr": stderr[-6000:]}


def checked_update(command, *, timeout=900):
    """Esegue un updater correggendo CLI che restituiscono 0 anche su errore."""
    result = run(command, timeout=timeout)
    lowered = result["output"].lower()
    if "upgrade failed" in lowered or "update failed" in lowered:
        result["ok"] = False
    return result


def as_user(user, command, timeout=900):
    env = user_env(user)
    argv = ["/usr/sbin/runuser", "-u", user, "--", "/usr/bin/env"]
    argv += [f"{key}={value}" for key, value in env.items()]
    argv += command
    return run(argv, timeout=timeout)


def versions(user):
    result = as_user(user, [SESSION_CTL, "version"], timeout=60)
    if result["ok"]:
        try:
            return json.loads(result["output"].splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            pass
    return {"user": user, "error": result["output"] or f"rc={result['rc']}"}


def unavailable_versions(snapshots):
    """Elenca harness che dopo l'update non sono eseguibili dai due ruoli."""
    errors = []
    for user, values in snapshots.items():
        if values.get("error"):
            errors.append(f"versioni ({user})")
            continue
        for harness in ("claude", "codex", "opencode"):
            value = values.get(harness)
            if not isinstance(value, str) or value.startswith("non disponibile:"):
                errors.append(f"{harness} ({user})")
    return errors


def launch_audit(config, report, args):
    """Esegue una verifica non interattiva, effimera e senza scritture."""
    project_user = config.get("AGENT_HUB_PROJECT_USER", "devagent")
    projects_root = config.get("AGENT_HUB_PROJECTS", "/srv/agent-workspace/projects")
    workdir = str(Path(projects_root) / args.project)
    summary = json.dumps({
        "before": report["before"], "after": report["after"],
        "updates": report["updates"],
    }, ensure_ascii=False, indent=2)
    prompt = f"""Audit effimero successivo all'aggiornamento notturno degli harness.

Versioni ed esiti osservati:
```json
{summary}
```

Per i soli componenti cambiati o falliti, confronta documentazione e note di rilascio
ufficiali con i rispettivi `--help` installati. Verifica in sola lettura i contratti CLI
usati da Agent Hub: comandi, flag, readiness, login status, catalogo modelli, runtime e
consumo. Considera Codex CLI, Claude Code e OpenCode nei ruoli PROJECT e SERVER.

Limiti obbligatori: non modificare file, impostazioni, credenziali o repository; non
installare pacchetti; non avviare TUI o sessioni temporanee; non eseguire build o suite
di test; non usare agent-report; non fare push, deploy, restart, rollback o escalation.
Se una verifica richiederebbe scritture, privilegi o input umano, dichiarala non
eseguita. Concludi con un riepilogo breve: compatibile/non compatibile, evidenze,
controlli omessi e azione manuale eventualmente consigliata.
"""
    command = [
        "/usr/bin/codex", "--search", "--ask-for-approval", "never", "exec",
        "--ephemeral", "--sandbox", "read-only", "--cd", workdir,
        "--model", args.model, "--config", f"model_reasoning_effort={args.effort}",
        prompt,
    ]
    started = datetime.now(timezone.utc).isoformat(timespec="seconds")
    result = as_user(project_user, command, timeout=args.audit_timeout)
    finished = datetime.now(timezone.utc).isoformat(timespec="seconds")
    return {
        "status": "COMPLETED" if result["ok"] else "FAILED",
        "ok": result["ok"], "rc": result["rc"],
        "started_at": started, "finished_at": finished,
        "summary": result["stdout"] or result["output"],
        "diagnostics": result["stderr"][-2000:] if not result["ok"] else "",
        "mode": "codex exec --ephemeral; sandbox read-only; approvals never",
    }


def needs_audit(report):
    """L'LLM non viene consumato nei cicli senza cambiamenti ne' errori."""
    return bool(report.get("changed") or report.get("errors"))


def read_previous(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def write_report(path, report):
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    temp = target.with_name(f".{target.name}.{os.getpid()}.tmp")
    temp.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    # La directory di stato resta privata; il gruppo del servizio systemd e'
    # quello di Agent Hub, che deve poter mostrare il risultato nella UI.
    os.chmod(temp, 0o640)
    os.replace(temp, target)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", default="agent-hub")
    parser.add_argument("--model", default="gpt-5.6-sol")
    parser.add_argument("--effort", default="high")
    parser.add_argument("--audit-timeout", type=int, default=DEFAULT_AUDIT_TIMEOUT)
    parser.add_argument("--state", default=DEFAULT_STATE)
    args = parser.parse_args()
    config = load_config()
    users = [config.get("AGENT_HUB_PROJECT_USER", "devagent"),
             config.get("AGENT_HUB_SERVER_USER", "hostagent")]

    lock_path = Path(args.state + ".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("aggiornamento harness già in corso", file=sys.stderr)
            return 0

        previous = read_previous(args.state)
        report = {"started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                  "before": {user: versions(user) for user in users}, "updates": []}

        report["updates"].append({"target": "codex (canale npm latest stabile)",
                                  **checked_update(["/usr/bin/codex", "update"], timeout=300)})
        report["updates"].append({"target": "opencode (installazione globale npm)",
                                  **checked_update(["/usr/bin/opencode", "upgrade", "--method", "npm"], timeout=300)})
        for user in users:
            report["updates"].append({"target": f"claude stable ({user})",
                                      **as_user(user, ["claude", "install", "stable"], timeout=300)})

        report["after"] = {user: versions(user) for user in users}
        report["changed"] = report["before"] != report["after"]
        report["errors"] = [step["target"] for step in report["updates"] if not step["ok"]]
        report["errors"].extend(unavailable_versions(report["after"]))
        audit_day = datetime.now().astimezone().date().isoformat()
        audit_key = json.dumps({"day": audit_day, "after": report["after"],
                                "errors": report["errors"]}, sort_keys=True)
        report["audit_key"] = audit_key
        report["audit"] = {}

        # Il controllo giornaliero degli updater resta sempre attivo; l'audit
        # LLM parte soltanto su un cambio reale o un errore. Un rerun identico
        # nello stesso giorno non consuma una seconda esecuzione.
        if needs_audit(report) and audit_key != previous.get("last_audit_key"):
            try:
                report["audit"] = launch_audit(config, report, args)
            except Exception as exc:  # il report deve sopravvivere a ogni failure
                report["audit"] = {"status": "FAILED", "ok": False,
                                   "summary": "audit fantasma non avviato",
                                   "diagnostics": str(exc)[-2000:]}
            if report["audit"]["ok"]:
                report["last_audit_key"] = audit_key
            else:
                report["last_audit_key"] = previous.get("last_audit_key", "")
        elif not needs_audit(report):
            report["last_audit_key"] = previous.get("last_audit_key", "")
            report["audit"] = {"status": "SKIPPED", "ok": True,
                               "reason": "nessuna versione cambiata e nessun errore"}
        else:
            report["last_audit_key"] = previous.get("last_audit_key", "")
            report["audit"] = {"status": "SKIPPED", "ok": True,
                               "reason": "audit già completato oggi per questi esiti"}

        report["finished_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        write_report(args.state, report)
        print(json.dumps(report, ensure_ascii=False))
        return 1 if report["errors"] or not report["audit"].get("ok", False) else 0


if __name__ == "__main__":
    raise SystemExit(main())
