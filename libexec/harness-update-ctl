#!/usr/bin/env python3
"""Aggiorna gli harness e apre un audit Agent Hub dopo ogni ciclo notturno.

Il job gira come root perché Codex e OpenCode sono installati globalmente;
Claude Code è invece aggiornato separatamente nelle home PROJECT e SERVER.
L'audit passa dal socket Unix privato e dalla normale API di creazione sessioni:
la sessione resta quindi visibile, persistente e soggetta allo stesso contratto
di qualunque sessione avviata dalla UI.
"""
import argparse
import fcntl
import http.client
import json
import os
import pwd
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


CONFIG_FILE = "/etc/agent-hub/config.env"
SESSION_CTL = "/usr/local/libexec/agent-hub/session-ctl"
DEFAULT_SOCKET = "/run/agent-hub/agent-hub.sock"
DEFAULT_STATE = "/var/lib/agent-hub/harness-update.json"


def load_config(path=CONFIG_FILE):
    data = {}
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except OSError:
        return data
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip("\"'")
    return data


def user_env(user):
    account = pwd.getpwnam(user)
    runtime = f"/run/user/{account.pw_uid}"
    return {
        "HOME": account.pw_dir, "USER": user, "LOGNAME": user,
        "SHELL": "/bin/bash", "LANG": "C.UTF-8",
        "PATH": f"{account.pw_dir}/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "XDG_RUNTIME_DIR": runtime,
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime}/bus",
    }


def run(command, *, env=None, timeout=900):
    try:
        result = subprocess.run(command, env=env, capture_output=True, text=True,
                                timeout=timeout, cwd=(env or {}).get("HOME") or "/")
        output = ((result.stdout or "") + (result.stderr or "")).strip()
        return {"ok": result.returncode == 0, "rc": result.returncode,
                "output": output[-6000:]}
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "rc": -1, "output": str(exc)[-6000:]}


def checked_update(command, *, timeout=900):
    """Esegue un updater correggendo CLI che restituiscono 0 anche su errore."""
    result = run(command, timeout=timeout)
    lowered = result["output"].lower()
    if "upgrade failed" in lowered or "update failed" in lowered:
        result["ok"] = False
    return result


def as_user(user, command, timeout=900):
    env = user_env(user)
    argv = ["/usr/sbin/runuser", "-u", user, "--", "/usr/bin/env"]
    argv += [f"{key}={value}" for key, value in env.items()]
    argv += command
    return run(argv, timeout=timeout)


def versions(user):
    result = as_user(user, [SESSION_CTL, "version"], timeout=60)
    if result["ok"]:
        try:
            return json.loads(result["output"].splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            pass
    return {"user": user, "error": result["output"] or f"rc={result['rc']}"}


def unavailable_versions(snapshots):
    """Elenca harness che dopo l'update non sono eseguibili dai due ruoli."""
    errors = []
    for user, values in snapshots.items():
        if values.get("error"):
            errors.append(f"versioni ({user})")
            continue
        for harness in ("claude", "codex", "opencode"):
            value = values.get(harness)
            if not isinstance(value, str) or value.startswith("non disponibile:"):
                errors.append(f"{harness} ({user})")
    return errors


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout=180):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.unix_path)


def api_request(socket_path, method, path, headers, body=None):
    conn = UnixHTTPConnection(socket_path)
    payload = json.dumps(body).encode() if body is not None else None
    request_headers = {"Host": "localhost", "Accept": "application/json", **headers}
    if payload is not None:
        request_headers["Content-Type"] = "application/json"
        request_headers["Content-Length"] = str(len(payload))
    conn.request(method, path, body=payload, headers=request_headers)
    response = conn.getresponse()
    raw = response.read()
    result_headers = {key.lower(): value for key, value in response.getheaders()}
    conn.close()
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        data = {"detail": raw.decode("utf-8", "replace")[:1000]}
    return response.status, result_headers, data


def launch_audit(config, report, args):
    identities = [x.strip() for x in config.get("AGENT_HUB_ALLOWED_USERS", "").split(",") if x.strip()]
    if not identities:
        raise RuntimeError("AGENT_HUB_ALLOWED_USERS non contiene alcuna identità")
    socket_path = config.get("AGENT_HUB_SOCKET", DEFAULT_SOCKET)
    identity = {"Tailscale-User-Login": identities[0]}
    status, _headers, bootstrap = api_request(socket_path, "GET", "/api/bootstrap", identity)
    if status != 200 or not bootstrap.get("csrf"):
        raise RuntimeError(f"bootstrap locale fallito (HTTP {status}): {bootstrap.get('detail', '')}")

    summary = json.dumps({
        "before": report["before"], "after": report["after"],
        "updates": report["updates"],
    }, ensure_ascii=False, indent=2)
    prompt = f"""Audit automatico successivo all'aggiornamento notturno degli harness.

Versioni ed esiti osservati:
```json
{summary}
```

Verifica con la documentazione ufficiale e con `--help` delle CLI installate se comandi,
flag, menu TUI, readiness, login, catalogo modelli, lettura runtime e consumo usati da
Agent Hub sono cambiati. Controlla almeno Codex, Claude Code e OpenCode per entrambi i
ruoli PROJECT e SERVER. Esegui i test pertinenti e applica nel repository agent-hub solo
le correzioni minime necessarie a mantenerlo funzionante. Non eseguire push o deploy.
Se serve installare file o unit host, completa prima il repository e termina con
NEEDS_HOST_ACTION; altrimenti registra COMPLETED con un riepilogo verificabile.
"""
    body = {
        "name": "Audit aggiornamento harness " + datetime.now().astimezone().strftime("%Y-%m-%d"),
        "environment": "PROJECT", "project_slug": args.project,
        "profile_id": "codex-openai", "model": args.model, "effort": args.effort,
        "permission_mode": "full", "prompt": prompt, "cols": 120, "rows": 40,
    }
    headers = {**identity, "X-CSRF-Token": bootstrap["csrf"]}
    status, response_headers, data = api_request(socket_path, "POST", "/api/sessions", headers, body)
    session_id = ((data.get("session") or {}).get("id") or
                  response_headers.get("x-agent-hub-session-id", ""))
    if status >= 400 and not session_id:
        raise RuntimeError(f"creazione audit fallita (HTTP {status}): {data.get('detail', '')}")
    return {"session_id": session_id, "http_status": status,
            "launch_error": data.get("detail", "") if status >= 400 else ""}


def read_previous(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def write_report(path, report):
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    temp = target.with_name(f".{target.name}.{os.getpid()}.tmp")
    temp.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(temp, 0o600)
    os.replace(temp, target)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", default="agent-hub")
    parser.add_argument("--model", default="gpt-5.6-sol")
    parser.add_argument("--effort", default="high")
    parser.add_argument("--state", default=DEFAULT_STATE)
    args = parser.parse_args()
    config = load_config()
    users = [config.get("AGENT_HUB_PROJECT_USER", "devagent"),
             config.get("AGENT_HUB_SERVER_USER", "hostagent")]

    lock_path = Path(args.state + ".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("aggiornamento harness già in corso", file=sys.stderr)
            return 0

        previous = read_previous(args.state)
        report = {"started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                  "before": {user: versions(user) for user in users}, "updates": []}

        report["updates"].append({"target": "codex (installazione globale)",
                                  **checked_update(["/usr/bin/codex", "update"], timeout=900)})
        report["updates"].append({"target": "opencode (installazione globale npm)",
                                  **checked_update(["/usr/bin/opencode", "upgrade", "--method", "npm"], timeout=900)})
        for user in users:
            report["updates"].append({"target": f"claude ({user})",
                                      **as_user(user, ["claude", "update"], timeout=900)})

        report["after"] = {user: versions(user) for user in users}
        report["changed"] = report["before"] != report["after"]
        report["errors"] = [step["target"] for step in report["updates"] if not step["ok"]]
        report["errors"].extend(unavailable_versions(report["after"]))
        audit_day = datetime.now().astimezone().date().isoformat()
        audit_key = json.dumps({"day": audit_day, "after": report["after"],
                                "errors": report["errors"]}, sort_keys=True)
        report["audit_key"] = audit_key
        report["audit"] = {}

        # La verifica è parte del ciclo notturno anche quando gli updater non
        # cambiano versione: aiuta a rilevare variazioni di help/menu e backend
        # che non coincidono con un numero versione locale diverso. Un rerun
        # identico nella stessa giornata non apre però una seconda sessione.
        if audit_key != previous.get("last_audit_key"):
            try:
                report["audit"] = launch_audit(config, report, args)
                report["last_audit_key"] = audit_key
            except Exception as exc:  # noqa: BLE001 - il report deve sopravvivere
                report["audit"] = {"error": str(exc)}
                report["last_audit_key"] = previous.get("last_audit_key", "")
        else:
            report["last_audit_key"] = previous.get("last_audit_key", "")
            report["audit"] = {"skipped": "audit già avviato oggi per questi esiti"}

        report["finished_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        write_report(args.state, report)
        print(json.dumps(report, ensure_ascii=False))
        return 1 if report["errors"] or report["audit"].get("error") else 0


if __name__ == "__main__":
    raise SystemExit(main())
