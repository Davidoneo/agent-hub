#!/usr/bin/env python3
"""Agent Hub — registrazione dello stato finale di una sessione.

Root-owned, eseguito tramite sudo come account di servizio (il proprietario del
database) da `agent-report`, che gli agenti lanciano come `devagent` o
`hostagent`. Non e' una API generica: accetta argomenti strutturati, valida
tutto e tocca soltanto le colonne di report della sessione indicata.

Effetti, nell'ordine:
  1. verifica che la sessione esista in SQLite (altrimenti esce 3);
  2. aggiorna `sessions` e inserisce una riga in `session_reports`;
  3. scrive atomicamente l'evento JSON in /srv/agent-workspace/reports/.

Idempotenza: ripetere lo stesso (stato, riepilogo) sulla stessa sessione non
crea una nuova riga di storico e non e' un errore; l'evento viene riscritto
identico. Cambiare stato o riepilogo aggiunge invece una riga allo storico.

Nessuna connessione di rete, in nessun ramo.
"""
import json
import os
import pwd
import re
import sqlite3
import sys
import tempfile
import uuid
from datetime import datetime, timezone

DB = os.environ.get("AGENT_HUB_DB", "/var/lib/agent-hub/agent-hub.sqlite3")
REPORT_DIR = os.environ.get("AGENT_HUB_REPORTS", "/srv/agent-workspace/reports")
STATUSES = ("COMPLETED", "NEEDS_INPUT", "WAITING_SESSION",
            "NEEDS_HOST_ACTION", "FAILED", "CANCELLED")
SESSION_RE = re.compile(r"^[0-9a-fA-F-]{6,40}$")
MAX_SUMMARY = 4000


def die(msg, code=2):
    print(json.dumps({"ok": False, "error": msg}), file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def db():
    conn = sqlite3.connect(DB, timeout=20)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


def write_event(payload):
    """Evento JSON locale, scritto atomicamente (tmp + rename)."""
    try:
        os.makedirs(REPORT_DIR, exist_ok=True)
    except OSError as exc:
        return f"directory eventi non creabile: {exc}"
    final = os.path.join(REPORT_DIR, f"{payload['session_id']}.json")
    tmp = ""
    data = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    try:
        # Nome imprevedibile e creazione O_EXCL, cosi' il file temporaneo non
        # puo' essere pre-creato come symlink verso un file dell'account DB.
        fd, tmp = tempfile.mkstemp(
            prefix=f".{payload['session_id']}.", suffix=".tmp", dir=REPORT_DIR)
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, final)          # sostituzione atomica
        with open(os.path.join(REPORT_DIR, "events.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=False) + "\n")
    except OSError as exc:
        try:
            if tmp:
                os.unlink(tmp)
        except OSError:
            pass
        return f"evento non scritto: {exc}"
    return ""


def cmd_report(argv):
    """report <session> <status> <summary> [waiting_for]."""
    if len(argv) < 3 or len(argv) > 4:
        die("uso: report <session-id> <status> <summary> [waiting-for]")
    # Il client e' deliberatamente non fidato. sudo valorizza SUDO_USER con
    # l'account Unix reale che ha ottenuto l'esecuzione come proprietario DB;
    # nessun argomento puo' sostituire questa identita'.
    caller = os.environ.get("SUDO_USER", "").strip()
    effective_user = pwd.getpwuid(os.geteuid()).pw_name
    if not caller or caller in ("root", effective_user):
        die("chiamante sudo non determinabile", 3)
    sid = argv[0].strip()
    if sid.startswith("agenthub-"):
        sid = sid[len("agenthub-"):]
    if not SESSION_RE.match(sid):
        die(f"identificatore di sessione non valido: {argv[0]}")
    status = argv[1].strip().upper()
    if status not in STATUSES:
        die(f"stato non ammesso: {argv[1]} — ammessi: {', '.join(STATUSES)}")
    summary = " ".join(argv[2].split())[:MAX_SUMMARY]
    source = "agent-report"
    unix_user = caller[:40]
    waiting_for = (argv[3] if len(argv) > 3 else "").strip()
    if waiting_for.startswith("agenthub-"):
        waiting_for = waiting_for[len("agenthub-"):]
    if status == "WAITING_SESSION":
        if not SESSION_RE.match(waiting_for):
            die("WAITING_SESSION richiede --waiting-for <session-id>")
        if waiting_for == sid:
            die("una sessione non puo' attendere se stessa")
    else:
        waiting_for = ""

    stamp = now()
    with db() as conn:
        row = conn.execute(
            "SELECT id, name, unix_user, report_status, report_summary, reported_at, "
            "waiting_for_session "
            "FROM sessions WHERE id=?", (sid,)).fetchone()
        if not row:
            die(f"sessione inesistente: {sid}", 3)
        if row["unix_user"] != caller:
            die(f"sessione non appartenente al chiamante {caller}", 3)
        if waiting_for and not conn.execute(
                "SELECT 1 FROM sessions WHERE id=?", (waiting_for,)).fetchone():
            die(f"sessione attesa inesistente: {waiting_for}", 3)
        duplicate = (row["report_status"] == status
                     and (row["report_summary"] or "") == summary
                     and (row["waiting_for_session"] or "") == waiting_for)
        if duplicate:
            stamp = row["reported_at"] or stamp
        else:
            conn.execute(
                "INSERT INTO session_reports (id,session_id,status,summary,waiting_for_session,"
                "reported_at,source,unix_user) VALUES (?,?,?,?,?,?,?,?)",
                (str(uuid.uuid4()), sid, status, summary, waiting_for, stamp, source, unix_user))
            conn.execute(
                "UPDATE sessions SET report_status=?, report_summary=?, reported_at=?, "
                "waiting_for_session=? "
                "WHERE id=?", (status, summary, stamp, waiting_for, sid))

    payload = {
        "session_id": sid,
        "status": status,
        "summary": summary,
        "waiting_for_session": waiting_for,
        "reported_at": stamp,
        "source": source,
        "unix_user": unix_user,
        "session_name": row["name"],
    }
    # nel file resta lo *stato*, non la cronaca della chiamata: `duplicate`
    # descrive l'invocazione e vive solo nella risposta a chi l'ha fatta
    err = write_event(payload)
    result = {"ok": True, **payload, "duplicate": duplicate}
    if err:
        result["event_error"] = err
    print(json.dumps(result, ensure_ascii=False))


def cmd_show(argv):
    """show <session> — ultimo stato registrato."""
    if len(argv) != 1:
        die("uso: show <session-id>")
    sid = argv[0].strip()
    if sid.startswith("agenthub-"):
        sid = sid[len("agenthub-"):]
    if not SESSION_RE.match(sid):
        die(f"identificatore di sessione non valido: {argv[0]}")
    with db() as conn:
        row = conn.execute("SELECT id,name,status,report_status,report_summary,reported_at,"
                           "waiting_for_session "
                           "FROM sessions WHERE id=?", (sid,)).fetchone()
    if not row:
        die(f"sessione inesistente: {sid}", 3)
    print(json.dumps({"ok": True, **dict(row)}, ensure_ascii=False))


COMMANDS = {"report": cmd_report, "show": cmd_show}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die("comandi: " + ", ".join(sorted(COMMANDS)))
    try:
        COMMANDS[sys.argv[1]](sys.argv[2:])
    except sqlite3.Error as exc:
        die(f"errore SQLite: {exc}", 4)


if __name__ == "__main__":
    main()
