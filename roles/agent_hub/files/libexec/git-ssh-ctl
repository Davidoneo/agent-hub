#!/usr/bin/env python3
"""Confina le deploy key alla sessione che le usa.

Tutte le sessioni di devagent girano con lo stesso UID: i permessi del
filesystem non possono distinguerle. Questo wrapper gira come root e ricava
il progetto NON da cio' che il chiamante dichiara, ma dalla catena dei
processi: risale i genitori fino a trovare il pane tmux che lo contiene,
mappa la sessione tmux sul progetto tramite il database dell'Agent Hub, e usa
soltanto la chiave di quel progetto.

La chiave stessa e' il confinamento: una deploy key apre un solo repository.
Una sessione lanciata su «lsar» ottiene la chiave di lsar e con quella non
puo' toccare nessun altro repository.

Uso (da core.sshCommand di git):  sudo -n git-ssh-ctl <argomenti ssh>
Diagnostica:                      sudo -n git-ssh-ctl --whoami

Il servizio host `lsar-auto-deploy.service` usa `--lsar-auto-deploy`. Questa
eccezione non si basa su argomenti dichiarati dal chiamante: il wrapper accetta
il flag soltanto se un antenato appartiene realmente al cgroup del servizio e
il chiamante sudo e' `devagent`.
"""
import os
import subprocess
import sqlite3
import sys

KEYS = "/etc/agent-hub/repo-keys"
DB = "/var/lib/agent-hub/agent-hub.sqlite3"
SOCKET = "agenthub"


def die(msg, code=2):
    print(f"git-ssh-ctl: {msg}", file=sys.stderr)
    sys.exit(code)


def ppid_of(pid):
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except OSError:
        pass
    return 0


def ancestors(pid):
    """PID di tutti gli antenati, dal chiamante fino a init."""
    seen = []
    while pid and pid != 1 and len(seen) < 64:
        seen.append(pid)
        pid = ppid_of(pid)
    return seen


def pane_map():
    """pane_pid -> nome della sessione tmux, per ogni utente con un server."""
    out = {}
    for user in os.listdir("/tmp"):
        if not user.startswith("tmux-"):
            continue
        try:
            uid = int(user.split("-", 1)[1])
        except ValueError:
            continue
        r = subprocess.run(
            ["tmux", "-S", f"/tmp/{user}/{SOCKET}", "list-panes", "-a",
             "-F", "#{pane_pid} #{session_name}"],
            capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            continue
        for line in r.stdout.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[0].isdigit():
                out[int(parts[0])] = (parts[1], uid)
    return out


def resolve_session():
    """Sessione tmux che contiene il processo chiamante. Non falsificabile:
    l'agente non puo' cambiare la propria discendenza."""
    panes = pane_map()
    for pid in ancestors(os.getpid()):
        if pid in panes:
            return panes[pid][0]
    return None


def slug_for(tmux_name):
    try:
        con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
        row = con.execute(
            "SELECT project_slug, unix_user FROM sessions WHERE tmux_name=? "
            "ORDER BY created_at DESC LIMIT 1", (tmux_name,)).fetchone()
        con.close()
    except sqlite3.Error as exc:
        die(f"database non leggibile: {exc}")
    if not row:
        return None, None
    return (row[0] or ""), (row[1] or "")


def in_service_cgroup(pid):
    """True se il processo appartiene al cgroup di agent-hub.service. Il
    cgroup lo assegna systemd: una sessione agentica non puo' entrarci."""
    try:
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as fh:
            return "agent-hub.service" in fh.read()
    except OSError:
        return False


def in_named_service_cgroup(pid, service):
    """True se systemd ha assegnato il processo al servizio indicato."""
    try:
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as fh:
            return service in fh.read()
    except OSError:
        return False


def auto_deploy_key(caller):
    """Chiave LSAR per il solo servizio host di auto-deploy."""
    flag = "--lsar-auto-deploy"
    if flag not in sys.argv[1:]:
        return None
    if caller != "devagent":
        die(f"{flag} richiede il chiamante devagent.")
    if not any(in_named_service_cgroup(pid, "lsar-auto-deploy.service")
               for pid in ancestors(os.getpid())):
        die(f"{flag} e' riservato a lsar-auto-deploy.service.")
    key = os.path.join(KEYS, "lsar", "id_ed25519")
    if not os.path.isfile(key):
        die("nessuna deploy key per il progetto «lsar».")
    return key


def provisioning_slug():
    """Il servizio web clona i repository quando un progetto viene creato:
    non c'e' ancora una sessione a cui legarsi. Quel percorso e' ammesso solo
    se il chiamante discende davvero da agent-hub.service."""
    if "--provision" not in sys.argv[1:]:
        return None
    if not any(in_service_cgroup(pid) for pid in ancestors(os.getpid())):
        die("--provision e' riservato al servizio Agent Hub.")
    i = sys.argv.index("--provision")
    if i + 1 >= len(sys.argv):
        die("--provision richiede lo slug del progetto.")
    return sys.argv[i + 1]


def main():
    caller = os.environ.get("SUDO_USER", "")

    automatic_key = auto_deploy_key(caller)
    if automatic_key:
        rest = [a for a in sys.argv[1:] if a != "--lsar-auto-deploy"]
        os.execv("/usr/bin/ssh", [
            "ssh", "-i", automatic_key,
            "-o", "IdentitiesOnly=yes",
            "-o", "StrictHostKeyChecking=accept-new",
            *rest,
        ])

    prov = provisioning_slug()
    if prov:
        key = os.path.join(KEYS, prov, "id_ed25519")
        if not os.path.isfile(key):
            die(f"nessuna deploy key per il progetto «{prov}».")
        rest = [a for a in sys.argv[1:] if a != "--provision" and a != prov]
        os.execv("/usr/bin/ssh", ["ssh", "-i", key, "-o", "IdentitiesOnly=yes",
                                  "-o", "StrictHostKeyChecking=accept-new", *rest])

    tmux_name = resolve_session()
    if not tmux_name:
        die("nessuna sessione Agent Hub risolvibile per questo processo: "
            "le deploy key sono utilizzabili solo da dentro una sessione.")

    slug, unix_user = slug_for(tmux_name)
    if slug is None:
        die(f"sessione {tmux_name} sconosciuta al database.")
    # La proprieta' della sessione si verifica per prima: un chiamante che non
    # e' l'utente della sessione non deve nemmeno sapere se ha un progetto.
    if caller and unix_user and caller != unix_user:
        die(f"la sessione {tmux_name} appartiene a {unix_user}, non a {caller}.")
    if not slug:
        die(f"la sessione {tmux_name} non e' legata a un progetto: "
            "nessuna chiave utilizzabile.")

    key = os.path.join(KEYS, slug, "id_ed25519")
    if not os.path.isfile(key):
        die(f"nessuna deploy key per il progetto «{slug}».")

    if "--whoami" in sys.argv[1:]:
        print(f"sessione={tmux_name} utente={unix_user} progetto={slug} chiave={key}")
        return

    os.execv("/usr/bin/ssh", [
        "ssh", "-i", key,
        "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=accept-new",
        *sys.argv[1:],
    ])


if __name__ == "__main__":
    main()
