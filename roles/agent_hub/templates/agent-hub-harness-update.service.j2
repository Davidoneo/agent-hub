# {{ ansible_managed }}
[Unit]
Description=Agent Hub - update harnesses and audit compatibility
After=network-online.target agent-hub.service
Wants=network-online.target

[Service]
Type=oneshot
Group={{ agent_hub_service_user }}
ExecStart={{ agent_hub_libexec }}/harness-update-ctl --project {{ agent_hub_harness_audit_project }} --model {{ agent_hub_harness_audit_model }} --effort {{ agent_hub_harness_audit_effort }} --audit-timeout {{ agent_hub_harness_audit_timeout }}
TimeoutStartSec=45min
# npm deve installare i binari globali leggibili/eseguibili dagli account
# PROJECT e SERVER. Il gruppo del processo permette al solo servizio Agent Hub
# di leggere il report 0640 e mostrarlo nella pagina Status.
UMask=0022
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-harness-update
