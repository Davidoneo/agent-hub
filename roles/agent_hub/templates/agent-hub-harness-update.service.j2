# {{ ansible_managed }}
[Unit]
Description=Agent Hub - update harnesses and audit compatibility
After=network-online.target agent-hub.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ agent_hub_libexec }}/harness-update-ctl --project {{ agent_hub_harness_audit_project }} --model {{ agent_hub_harness_audit_model }} --effort {{ agent_hub_harness_audit_effort }}
TimeoutStartSec=30min
# npm deve installare i binari globali leggibili/eseguibili dagli account
# PROJECT e SERVER. Il report di stato applica comunque mode 0600 in modo
# esplicito prima del rename atomico.
UMask=0022
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-harness-update
