# {{ ansible_managed }}
[Unit]
Description=Agent Hub - persistent agent sessions behind a private web UI
Documentation=file://{{ agent_hub_root }}/README.md
Requires=agent-hub.socket
After=network-online.target agent-hub.socket{% if agent_hub_require_tailscale %} tailscaled.service{% endif %}
Wants=network-online.target

[Service]
Type=simple
User={{ agent_hub_service_user }}
Group={{ agent_hub_service_user }}
SupplementaryGroups={{ agent_hub_agent_group }}
WorkingDirectory={{ agent_hub_root }}/app
EnvironmentFile={{ agent_hub_config_dir }}/config.env
ExecStart={{ agent_hub_root }}/.venv/bin/uvicorn main:app \
  --fd 3 \
  --no-server-header --proxy-headers --forwarded-allow-ips '*'
ExecStartPost={{ agent_hub_libexec }}/health-ctl --backend-only
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
LimitNOFILE=8192:524288
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub

# The agent sessions live in the users' own tmux servers, outside this
# cgroup: stopping the web service must not kill the work in progress.
KillMode=control-group

[Install]
WantedBy=multi-user.target
