# {{ ansible_managed }}
# Agent Hub service configuration. Edit through Ansible, not by hand.

AGENT_HUB_SOCKET={{ agent_hub_socket }}

# Tailscale identities allowed to reach the UI (Tailscale-User-Login header).
AGENT_HUB_ALLOWED_USERS={{ agent_hub_allowed_users | join(',') }}

# Expected HTTPS origin for the CSRF and WebSocket checks.
AGENT_HUB_ORIGIN={{ agent_hub_origin }}

# Set to 0 only for local debugging without Tailscale identity headers.
AGENT_HUB_REQUIRE_TAILSCALE={{ '1' if agent_hub_require_tailscale | bool else '0' }}

# Unix accounts. Read both by the service and by the privileged wrappers:
# sudo strips the environment, so the wrappers read this file directly.
AGENT_HUB_SERVICE_USER={{ agent_hub_service_user }}
AGENT_HUB_PROJECT_USER={{ agent_hub_project_user }}
AGENT_HUB_SERVER_USER={{ agent_hub_server_user }}
AGENT_HUB_SERVER_HOME=/home/{{ agent_hub_server_user }}

# Paths
AGENT_HUB_DB={{ agent_hub_state_dir }}/agent-hub.sqlite3
AGENT_HUB_PROFILES={{ agent_hub_config_dir }}/profiles.json
AGENT_HUB_LOGS={{ agent_hub_workspace }}/logs
AGENT_HUB_PROJECTS={{ agent_hub_workspace }}/projects
AGENT_HUB_KNOWLEDGE={{ agent_hub_workspace }}/knowledge
